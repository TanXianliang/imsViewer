{
  "$schema": "https://raw.githubusercontent.com/nicehash/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "imsViewer",
  "version": "1.2.6",
  "identifier": "com.imsviewer.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "imsViewer",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/models/sscd_disc_mixup.onnx",
      "resources/models/sscd_disc_mixup.json",
      "resources/models/text-detection.rten",
      "resources/models/text-recognition.rten"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg", "png", "webp", "avif"],
        "name": "Image",
        "description": "Image File"
      },
      {
        "ext": ["ims.jpg", "ims.png"],
        "name": "IMS Container",
        "description": "IMS Container File"
      }
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/TanXianliang/imsViewer/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDRjBFNTYxRDc5MzhFREUKUldUZWpwUFhZZVh3dkpkNG5OTldnY285aVVEbStjQXlHTENRTnU2dHJlcUJwdlpEYjE3V09HalUK"
    }
  }
}
